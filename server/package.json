{
  "name": "@idkdo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "tsx --conditions=development src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0 --format ../scripts/eslint-agent-formatter.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@idkdo/db": "workspace:*",
    "@idkdo/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  }
}
