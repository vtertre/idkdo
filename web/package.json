{
  "name": "@idkdo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @idkdo/shared build && ng build && node scripts/verify-pwa-cache-policy.mjs",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0 --format ../scripts/eslint-agent-formatter.mjs",
    "test": "ng test --watch=false && pnpm run build"
  },
  "dependencies": {
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "@angular/service-worker": "^22.0.2",
    "@idkdo/shared": "workspace:*",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "jsdom": "^28.0.0",
    "vitest": "^4.0.8"
  }
}
